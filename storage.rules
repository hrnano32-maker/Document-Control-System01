rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && profile().active == true; }
    function isDcc() { return activeUser() && profile().role == 'DCC_ADMIN'; }
    function sameDepartment(department) { return activeUser() && profile().department == department; }

    match /dcs/documents/{documentId}/{fileName} {
      allow read: if activeUser();
      allow write: if isDcc() && request.resource.size < 25 * 1024 * 1024;
    }

    match /dcs/dar-attachments/{uid}/{fileName} {
      allow read: if activeUser();
      allow create: if activeUser() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /dcs/signatures/{uid}/{fileName} {
      allow read: if activeUser();
      allow create: if activeUser() && request.auth.uid == uid && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /dcs/onboarding/{department}/{fileName} {
      allow read: if isDcc();
      allow create, update, delete: if false;
    }

    match /dcs/signatures/{uid}/{distributionId}/{fileName} {
      allow read: if isDcc() || request.auth.uid == uid;
      allow create: if activeUser() && request.auth.uid == uid && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /dcs/dar-attachments/{uid}/{darId}/{fileName} {
      allow read: if isDcc() || request.auth.uid == uid;
      allow create: if activeUser() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /dcs/distributions/{distributionId}/controlled/{fileName} {
      allow read: if activeUser() && (isDcc() || (
        firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.departmentFileKeys[profile().department] + '.pdf' == fileName
        &&
        firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.targetDepartments.hasAny([profile().department])
        && request.time <= firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.expirationAt
        && !(profile().department in firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.receipts)
      ));
      allow create, update: if isDcc() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isDcc();
    }

    match /dcs/distributions/{distributionId}/controlled/{departmentKey}/{fileName} {
      allow read: if activeUser() && (isDcc() || (
        firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.departmentFileKeys[profile().department] == departmentKey
        && firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.targetDepartments.hasAny([profile().department])
        && request.time <= firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.expirationAt
        && !(profile().department in firestore.get(/databases/(default)/documents/dcs_distributions/$(distributionId)).data.receipts)
      ));
      allow create, update: if isDcc() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isDcc();
    }

    match /dcs/distributions/{distributionId}/source/{fileName} {
      allow read, create, update, delete: if isDcc();
    }

    match /dcs/archive/{allPaths=**} {
      allow read, write: if isDcc();
    }

    match /dcs/distribution-sheet-signatures/{uid}/{distributionId}/{fileName} {
      allow read: if isDcc();
      allow create, update: if isDcc() && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isDcc();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
