rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && profile().active == true; }
    function isDcc() { return activeUser() && profile().role == 'DCC_ADMIN'; }
    function sameDepartment(department) { return activeUser() && profile().department == department; }
    // Firestore Rules have no loops: bound and validate every supplied holder.
    function departmentHolderAllowed(holders, index) {
      return index >= holders.size() || (
        holders[index] is map
        && holders[index].dept is string
        && holders[index].checked is bool
        && (!(holders[index].dept in ['QMR', 'Customer Rep']) || holders[index].checked == false)
      );
    }
    function departmentHoldersAllowed(holders) {
      return holders is list && holders.size() <= 32
        && departmentHolderAllowed(holders, 0)
        && departmentHolderAllowed(holders, 1)
        && departmentHolderAllowed(holders, 2)
        && departmentHolderAllowed(holders, 3)
        && departmentHolderAllowed(holders, 4)
        && departmentHolderAllowed(holders, 5)
        && departmentHolderAllowed(holders, 6)
        && departmentHolderAllowed(holders, 7)
        && departmentHolderAllowed(holders, 8)
        && departmentHolderAllowed(holders, 9)
        && departmentHolderAllowed(holders, 10)
        && departmentHolderAllowed(holders, 11)
        && departmentHolderAllowed(holders, 12)
        && departmentHolderAllowed(holders, 13)
        && departmentHolderAllowed(holders, 14)
        && departmentHolderAllowed(holders, 15)
        && departmentHolderAllowed(holders, 16)
        && departmentHolderAllowed(holders, 17)
        && departmentHolderAllowed(holders, 18)
        && departmentHolderAllowed(holders, 19)
        && departmentHolderAllowed(holders, 20)
        && departmentHolderAllowed(holders, 21)
        && departmentHolderAllowed(holders, 22)
        && departmentHolderAllowed(holders, 23)
        && departmentHolderAllowed(holders, 24)
        && departmentHolderAllowed(holders, 25)
        && departmentHolderAllowed(holders, 26)
        && departmentHolderAllowed(holders, 27)
        && departmentHolderAllowed(holders, 28)
        && departmentHolderAllowed(holders, 29)
        && departmentHolderAllowed(holders, 30)
        && departmentHolderAllowed(holders, 31);
    }
    function recipientReceiptUpdate() {
      let dept = profile().department;
      return activeUser()
        && resource.data.targetDepartments.hasAny([dept])
        && request.time <= resource.data.expirationAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts', 'status', 'allDownloadedAt', 'storageStatus', 'updatedAt'])
        && request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([dept])
        && !(dept in resource.data.receipts)
        && request.resource.data.receipts[dept].dept == dept
        && request.resource.data.receipts[dept].receivedCopies == resource.data.allocationByDepartment[dept]
        && request.resource.data.receipts[dept].downloaderName is string
        && request.resource.data.receipts[dept].downloaderUid == request.auth.uid
        && request.resource.data.receipts[dept].downloadedAt is string;
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isDcc());
      allow create: if isDcc();
      allow update: if isDcc() || (
        activeUser()
        && request.auth.uid == uid
        && resource.data.mustChangePassword == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
      );
      allow delete: if false;
    }

    match /dcs_user_registrations/{id} {
      allow read: if isDcc();
      allow create, update, delete: if false;
    }

    match /dcs_documents/{id} {
      allow read: if activeUser();
      allow create, update: if isDcc();
      allow delete: if false;
    }

    match /dcs_dars/{id} {
      allow read: if isDcc() || sameDepartment(resource.data.requestDept);
      allow create: if activeUser()
        && (isDcc() || sameDepartment(request.resource.data.requestDept))
        && (isDcc() || departmentHoldersAllowed(request.resource.data.distributionHolders))
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterSignature is string
        && request.resource.data.requesterSignature.size() > 0
        && request.resource.data.deptApproverName is string
        && request.resource.data.deptApproverName.size() > 0
        && request.resource.data.deptApproverTitle is string
        && request.resource.data.deptApproverTitle.size() > 0
        && request.resource.data.deptApproverDate is string
        && request.resource.data.deptApproverSignature is string
        && request.resource.data.deptApproverSignature.size() > 0;
      allow update: if isDcc() || (
        sameDepartment(resource.data.requestDept) &&
        resource.data.status in ['PENDING_REVIEW', 'UNDER_REVIEW'] &&
        request.resource.data.requestDept == resource.data.requestDept &&
        request.resource.data.status == resource.data.status &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['distributionHolders'])
          || departmentHoldersAllowed(request.resource.data.distributionHolders.removeAll(resource.data.distributionHolders))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requesterSignature', 'deptApproverName', 'deptApproverTitle', 'deptApproverDate',
          'deptApproverSignature', 'reviewItems', 'distributionHolders', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    match /dcs_distributions/{id} {
      allow read: if isDcc() || resource.data.targetDepartments.hasAny([profile().department]);
      allow create: if isDcc();
      allow update: if isDcc() || recipientReceiptUpdate();
      allow delete: if false;
    }

    match /dcs_copy_requests/{id} {
      allow read: if isDcc() || sameDepartment(resource.data.dept);
      allow create: if activeUser()
        && sameDepartment(request.resource.data.dept)
        && request.resource.data.status == 'PENDING'
        && get(/databases/$(database)/documents/dcs_distributions/$(request.resource.data.distributionId)).data.targetDepartments.hasAny([profile().department]);
      allow update: if isDcc();
      allow delete: if false;
    }

    match /dcs_announcements/{id} {
      allow read: if isDcc() || (activeUser() && resource.data.targetDepartments.hasAny([profile().department]));
      allow create: if isDcc()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'PUBLISHED';
      allow update: if isDcc() || (
        activeUser()
        && resource.data.status == 'PUBLISHED'
        && resource.data.targetDepartments.hasAny([profile().department])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads', 'acknowledgements', 'updatedAt'])
        && request.resource.data.reads.diff(resource.data.reads).affectedKeys().hasOnly([profile().department])
        && request.resource.data.acknowledgements.diff(resource.data.acknowledgements).affectedKeys().hasOnly([profile().department])
      );
      allow delete: if false;
    }

    match /dcs_audit_logs/{id} {
      allow read: if isDcc() || sameDepartment(resource.data.actorDept);
      allow create: if activeUser() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /dcs_counters/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.value == 1;
      allow update: if activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'kind', 'year', 'updatedAt'])
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.year == resource.data.year;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
